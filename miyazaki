<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>九州五天四夜：大自然與爆膽美食之旅</title>
    <!-- 載入 Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- 載入 Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        /* 隱藏卷軸但保持可滑動功能 */
        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .hide-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="bg-slate-50 font-sans text-slate-800 selection:bg-emerald-200 selection:text-emerald-900 min-h-screen">

    <!-- Hero Section -->
    <header class="relative bg-gradient-to-br from-emerald-800 to-teal-900 text-white pt-20 pb-16 px-6 overflow-hidden">
        <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-white via-transparent to-transparent"></div>
        <div class="max-w-4xl mx-auto relative z-10">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-700/50 border border-emerald-500/30 text-sm font-medium mb-6">
                <i data-lucide="map-pin" class="w-4 h-4"></i> 日本九州
            </div>
            <h1 class="text-4xl md:text-5xl font-bold mb-4 leading-tight tracking-tight">
                五天四夜大自然與<br class="md:hidden" /><span class="text-orange-400">爆膽美食</span>之旅
            </h1>
            <p class="text-emerald-100 text-lg md:text-xl max-w-2xl opacity-90">
                從宮崎的南蠻雞到高千穗的神話秘境，再到阿蘇的壯闊火山與赤牛丼。這是一趟結合自駕樂趣、絕美風景與在地美食的極致體驗。
            </p>
        </div>
    </header>

    <!-- Flight Info Card -->
    <section class="max-w-4xl mx-auto px-6 -mt-8 relative z-20">
        <div class="bg-white rounded-2xl shadow-xl shadow-slate-200/50 p-6 flex flex-col md:flex-row justify-between items-center gap-6 border border-slate-100">
            <div class="flex-1 w-full">
                <div class="flex items-center gap-2 text-slate-500 text-sm font-semibold mb-2 uppercase tracking-wider">
                    <i data-lucide="plane" class="w-4 h-4"></i> 去程航班
                </div>
                <div class="font-medium text-slate-800">IT742</div>
                <div class="text-lg font-bold text-emerald-700 mt-1">06:20 桃園機場 (TPE)</div>
                <div class="text-sm text-slate-500 flex items-center gap-1 mt-1">
                    <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i> 09:20 宮崎機場 (KMI)
                </div>
            </div>
            
            <div class="hidden md:flex flex-col items-center justify-center px-8 border-x border-slate-100">
                <div class="text-xs text-slate-400 font-medium mb-1">飛行時間</div>
                <div class="px-4 py-1 bg-slate-100 rounded-full text-sm font-semibold text-slate-600">
                    約 2 小時
                </div>
            </div>

            <div class="flex-1 w-full md:text-right">
                <div class="flex items-center md:justify-end gap-2 text-slate-500 text-sm font-semibold mb-2 uppercase tracking-wider">
                    <i data-lucide="plane" class="w-4 h-4 transform rotate-180"></i> 回程航班
                </div>
                <div class="font-medium text-slate-800">IT743</div>
                <div class="text-lg font-bold text-orange-600 mt-1">10:20 宮崎機場 (KMI)</div>
                <div class="text-sm text-slate-500 flex items-center md:justify-end gap-1 mt-1">
                    12:00 桃園機場 (TPE) <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <main class="max-w-4xl mx-auto px-6 py-12">
        
        <!-- Day Navigation Tabs (Generated by JS) -->
        <div id="tabs-container" class="flex overflow-x-auto hide-scrollbar gap-3 mb-10 pb-2">
            <!-- Tabs will be injected here -->
        </div>

        <!-- Day Content (Generated by JS) -->
        <div id="day-content" class="bg-white rounded-3xl p-6 md:p-10 shadow-sm border border-slate-100 relative">
            <!-- Content will be injected here -->
        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-slate-800 text-slate-400 py-8 text-center text-sm">
        <p>九州五天四夜自駕遊行程規劃</p>
        <p class="mt-2 text-slate-500">Have a safe and wonderful trip!</p>
    </footer>

    <!-- JavaScript Data and Logic -->
    <script>
        const itineraryData = [
            {
                day: 1,
                title: "宮崎南部海岸與巨無霸烏龍麵、燒肉雙重奏",
                events: [
                    { time: "09:00 - 10:30", type: "car", title: "抵達宮崎機場，辦理租車", desc: "準備開啟美好的九州之旅。" },
                    { time: "11:00 - 12:30", type: "food", title: "【午餐】百姓うどん (百姓烏龍麵)", desc: "抵達宮崎的第一餐！挑戰在地名店的巨無霸份量，體驗著名的「烏龍麵塔」或超浮誇巨無霸刨冰！" },
                    { time: "13:30 - 17:00", type: "spot", title: "日南海岸南下遊覽", desc: "走訪 日南太陽花園 (Sun Messe) 以及 充滿神話色彩的 鵜戶神宮。" },
                    { time: "18:00 - 20:00", type: "food", title: "【晚餐】宮崎牛焼肉 KUROUSHI 黒牛", desc: "回到宮崎市區，享用高品質的精肉卸直営店宮崎牛直營燒肉，大口吃肉超級過癮。" },
                    { time: "21:00", type: "food", title: "【宵夜】炭烤地雞 丸萬燒鳥 本店", desc: "如果胃還有空間，點一份帶有炭香、充滿嚼勁的帶骨地雞腿，配上一杯生啤酒，完美結束第一天。" },
                ],
                hotel: {
                    name: "宮崎縣第一酒店 (Miyazaki Daiichi Hotel)",
                    location: "宮崎市區",
                    link: "https://www.agoda.com/zh-hk/miyazaki-daiichi-hotel/hotel/miyazaki-jp.html?countryId=3&finalPriceView=1&isShowMobileAppPrice=false&cid=1922895&numberOfBedrooms=&familyMode=false&adults=2&children=0&rooms=1&maxRooms=0&checkIn=2026-04-13&isCalendarCallout=false&childAges=&numberOfGuest=0&missingChildAges=false&travellerType=1&showReviewSubmissionEntry=false&currencyCode=TWD&isFreeOccSearch=false&tag=979f082d-06a4-4f5d-9b81-0d1bbf132dd2&flightSearchCriteria=%5Bobject+Object%5D&tspTypes=3&los=1&searchrequestid=facbbc05-da4b-4334-843a-ac44885c5da9&ds=fgEAdNrDBshSkZIE"
                }
            },
            {
                day: 2,
                title: "高千穗峽谷與夜神樂神話之夜",
                events: [
                    { time: "08:00 - 08:30", type: "food", title: "【早餐】住宿周圍超商", desc: "出發前在住宿附近的超商簡單解決早餐，準備前往高千穗。" },
                    { time: "08:30 - 11:30", type: "car", title: "東九州自動車道北上前往高千穗", desc: "順遊延岡市的 港神社，隨後直奔高千穗町。" },
                    { time: "11:30 - 13:00", type: "food", title: "【午餐】高千穗町內在地美食", desc: "抵達高千穗後，可品嚐知名的流水麵或當地特色定食。" },
                    { time: "13:30 - 16:00", type: "spot", title: "高千穗峽", desc: "遊覽壯麗的高千穗峽，欣賞真名井瀑布。（若要划船強烈建議事先上網預約）" },
                    { time: "16:30 - 17:30", type: "spot", title: "高千穗神社", desc: "參拜擁有悠久歷史的高千穗神社，感受莊嚴肅穆的神話氣息。" },
                    { time: "18:00 - 19:30", type: "food", title: "【晚餐】高千穂 鶏の炭火焼 吾平店", desc: "在高千穗町內品嚐極品「高千穗牛」燒烤或鐵板燒。" },
                    { time: "20:00 - 21:00", type: "spot", title: "高千穗神社 夜神樂表演", desc: "飯後前往高千穗神社神樂殿，欣賞被指定為國家重要無形民俗文化財的「夜神樂」，為神話之鄉畫下完美句點。" },
                ],
                hotel: {
                    name: "岩戶民宿 (Guesthouse Iwato)",
                    location: "高千穗町",
                    link: "https://www.booking.com/hotel/jp/gesutohausuiwato.zh-tw.html?aid=399012&label=takachiho-LKYK%2A76eFB%2AVlmN_9Wi%2AfAS393054275486%3Apl%3Ata%3Ap1%3Ap2%3Aac%3Aap%3Aneg%3Afi%3Atikwd-356890142158%3Alp9222031%3Ali%3Adec%3Adm%3Appccp%3DUmFuZG9tSVYkc2RlIyh9YR10fBTovuitswFzoSdli7I&sid=84d81706289a2b51e1751c483355269b&all_sr_blocks=277388104_270925082_2_0_0&checkin=2026-04-14&checkout=2026-04-15&dest_id=900051135&dest_type=city&dist=0&group_adults=2&group_children=0&hapos=1&highlighted_blocks=277388104_270925082_2_0_0&hpos=1&matching_block_id=277388104_270925082_2_0_0&no_rooms=1&req_adults=2&req_children=0&room1=A%2CA&sb_price_type=total&sr_order=popularity&sr_pri_blocks=277388104_270925082_2_0_0__734627&srepoch=1774015133&srpvid=f2a6622d5b2403af&type=total&ucfs=1&"
                }
            },
            {
                day: 3,
                title: "壯闊阿蘇火山群",
                events: [
                    { time: "08:00 - 08:30", type: "food", title: "【早餐】住宿周圍超商", desc: "早晨在民宿周圍的超商買個早餐，準備出發前往阿蘇。" },
                    { time: "08:30 - 10:00", type: "spot", title: "上色見熊野座神社", desc: "從高千穗出發，走訪彷彿異世界入口的神社，感受不可思議的神秘氣息。" },
                    { time: "10:30 - 13:30", type: "food", title: "【午餐】いまきん食堂 (Imakin食堂)", desc: "阿蘇最有名的赤牛丼老店！強烈建議 10:30 抵達先抽號碼牌，用滿滿的半熟牛肉片補足駕駛疲勞。" },
                    { time: "14:00 - 16:30", type: "spot", title: "米塚、草千里之濱、阿蘇火山", desc: "吃飽後上山，沿路欣賞可愛的米塚、遼闊的草千里草原與馬匹，並遠眺壯觀的阿蘇火山口。" },
                    { time: "16:30 - 18:00", type: "car", title: "牛奶之路前往熊本市區", desc: "馳騁在風景如畫的牛奶之路（大觀峰附近），伴隨著夕陽餘暉下山，開往熊本市區。" },
                    { time: "18:30", type: "food", title: "【晚餐】勝烈亭 新市街本店", desc: "推薦市區的超人氣炸豬排，肉質軟嫩且份量十足，滿足味蕾。" },
                ],
                hotel: {
                    name: "Dormy Inn飯店-熊本天然溫泉",
                    location: "熊本市區",
                    link: "https://www.trip.com/t/Dv0HivJhLU2"
                }
            },
            {
                day: 4,
                title: "長途跋涉深入秘境與宮崎最終補給",
                events: [
                    { time: "08:00 - 08:30", type: "food", title: "【早餐】住宿周圍超商", desc: "悠閒享用超商早餐後，準備退房迎接今天的長途駕駛。" },
                    { time: "08:30 - 11:30", type: "car", title: "駛入深山：前往椎葉村", desc: "從熊本出發，挑戰前往日本三大秘境之一「椎葉村」的蜿蜒山路。" },
                    { time: "11:30 - 14:00", type: "spot", title: "深入秘境：椎葉村遊覽與午餐", desc: "欣賞深山壯麗風景與傳統聚落，午餐在村內簡單享用蕎麥麵或超商輕食。" },
                    { time: "14:00 - 17:00", type: "car", title: "返回宮崎市區", desc: "結束秘境探險，駛出山區返回宮崎市區（車程較長，請適時休息）。" },
                    { time: "17:00 - 19:30", type: "spot", title: "宮崎市區悠閒採買", desc: "在永旺夢樂城 AEON MALL 或車站周邊悠閒逛街，採買伴手禮。" },
                    { time: "20:00", type: "food", title: "【晚餐】辛麺屋 桝元 宮崎本店", desc: "用宮崎特有的靈魂美食「辛麵」做收尾！辣度可自由選擇，舒緩一整天開車的疲勞。" },
                ],
                hotel: {
                    name: "宮崎市區飯店",
                    location: "宮崎市區",
                    link: null
                }
            },
            {
                day: 5,
                title: "滿載而歸",
                events: [
                    { time: "06:30 - 07:00", type: "food", title: "【早餐】住宿周圍超商", desc: "早起前往住宿周圍的超商買個飯糰或咖啡，吃飽準備前往機場還車。" },
                    { time: "07:00", type: "car", title: "前往機場", desc: "準備前往宮崎機場還車。" },
                    { time: "09:00", type: "car", title: "搭機返家", desc: "搭乘 IT743 班機，帶著滿滿的回憶回到溫暖的家。" },
                ],
                hotel: null
            }
        ];

        // 輔助函式：根據事件類型取得對應的圖示與顏色
        const getEventStyles = (type) => {
            switch (type) {
                case 'food':
                    return { icon: 'utensils', color: 'bg-orange-100 text-orange-600', dot: 'bg-orange-500' };
                case 'spot':
                    return { icon: 'camera', color: 'bg-emerald-100 text-emerald-600', dot: 'bg-emerald-500' };
                case 'car':
                    return { icon: 'car', color: 'bg-blue-100 text-blue-600', dot: 'bg-blue-500' };
                default:
                    return { icon: 'map-pin', color: 'bg-gray-100 text-gray-600', dot: 'bg-gray-500' };
            }
        };

        let activeDay = 1;

        // 渲染上方的天數頁籤
        function renderTabs() {
            const tabsContainer = document.getElementById('tabs-container');
            tabsContainer.innerHTML = '';
            
            itineraryData.forEach(day => {
                const btn = document.createElement('button');
                const isActive = activeDay === day.day;
                
                btn.className = `flex-shrink-0 px-6 py-3 rounded-xl font-bold text-base transition-all duration-300 flex items-center gap-2 ${
                    isActive 
                    ? 'bg-emerald-600 text-white shadow-lg shadow-emerald-200' 
                    : 'bg-white text-slate-500 hover:bg-slate-100 border border-slate-200'
                }`;
                
                btn.onclick = () => {
                    activeDay = day.day;
                    renderTabs(); // 重新渲染頁籤以更新樣式
                    renderContent(); // 重新渲染內容
                };
                
                btn.innerHTML = `
                    <i data-lucide="calendar" class="w-[18px] h-[18px] ${isActive ? 'opacity-100' : 'opacity-50'}"></i>
                    Day ${day.day}
                `;
                
                tabsContainer.appendChild(btn);
            });
        }

        // 渲染下方的行程內容
        function renderContent() {
            const contentContainer = document.getElementById('day-content');
            const dayData = itineraryData.find(d => d.day === activeDay);
            
            let eventsHtml = dayData.events.map(event => {
                const styles = getEventStyles(event.type);
                return `
                    <div class="relative flex flex-col md:flex-row gap-6 md:gap-10 items-start group">
                        <!-- Time -->
                        <div class="md:w-[100px] flex-shrink-0 pt-1 md:text-right flex md:block items-center gap-3">
                            <div class="md:hidden absolute -left-[29px] w-4 h-4 rounded-full border-4 border-white ${styles.dot} shadow-sm z-10"></div>
                            <div class="text-slate-500 font-bold bg-slate-100 md:bg-transparent px-3 py-1 md:p-0 rounded-md text-sm md:text-base">
                                ${event.time}
                            </div>
                        </div>

                        <!-- Desktop dot indicator -->
                        <div class="hidden md:block absolute left-[111px] top-2 w-4 h-4 rounded-full border-4 border-white ${styles.dot} shadow-sm z-10 transition-transform group-hover:scale-125"></div>

                        <!-- Content Card -->
                        <div class="flex-1 bg-white border border-slate-100 rounded-2xl p-5 shadow-sm hover:shadow-md transition-shadow">
                            <div class="flex items-start gap-4">
                                <div class="p-3 rounded-xl flex-shrink-0 ${styles.color}">
                                    <i data-lucide="${styles.icon}" class="w-5 h-5"></i>
                                </div>
                                <div>
                                    <h3 class="text-lg font-bold text-slate-800 mb-2 leading-snug">${event.title}</h3>
                                    <p class="text-slate-600 leading-relaxed text-sm md:text-base">${event.desc}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');

            let hotelHtml = '';
            if (dayData.hotel) {
                let linkHtml = dayData.hotel.link ? `
                    <a href="${dayData.hotel.link}" target="_blank" rel="noopener noreferrer" class="w-full md:w-auto text-center px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white font-medium rounded-xl transition-colors flex items-center justify-center gap-2">
                        查看住宿資訊 <i data-lucide="external-link" class="w-4 h-4"></i>
                    </a>
                ` : '';

                hotelHtml = `
                    <div class="mt-12 pt-8 border-t border-slate-100">
                        <div class="bg-purple-50 rounded-2xl p-6 border border-purple-100">
                            <div class="flex flex-col md:flex-row items-center justify-between gap-4">
                                <div class="flex items-center gap-4 w-full md:w-auto">
                                    <div class="bg-purple-100 text-purple-600 p-3 rounded-xl flex-shrink-0">
                                        <i data-lucide="bed" class="w-6 h-6"></i>
                                    </div>
                                    <div>
                                        <div class="text-sm font-bold text-purple-600 mb-1 flex items-center gap-1">
                                            <i data-lucide="moon" class="w-3.5 h-3.5"></i> 今晚住宿
                                        </div>
                                        <div class="text-lg font-bold text-slate-800">${dayData.hotel.name}</div>
                                        <div class="text-sm text-slate-500 mt-1 flex items-center gap-1">
                                            <i data-lucide="map-pin" class="w-3.5 h-3.5"></i> ${dayData.hotel.location}
                                        </div>
                                    </div>
                                </div>
                                ${linkHtml}
                            </div>
                        </div>
                    </div>
                `;
            }

            contentContainer.innerHTML = `
                <div class="mb-10 text-center md:text-left">
                    <h2 class="text-2xl md:text-3xl font-bold text-slate-800">
                        <span class="text-emerald-600 mr-3">Day ${dayData.day}</span> 
                        ${dayData.title}
                    </h2>
                </div>
                <div class="relative pl-4 md:pl-0">
                    <div class="absolute left-[23px] md:left-[119px] top-4 bottom-4 w-0.5 bg-slate-100"></div>
                    <div class="space-y-10">
                        ${eventsHtml}
                    </div>
                </div>
                ${hotelHtml}
            `;

            // 每次渲染完 HTML 後，呼叫 Lucide 將 <i> 標籤轉換為 SVG 圖標
            lucide.createIcons();
        }

        // 初始化網站
        document.addEventListener('DOMContentLoaded', () => {
            renderTabs();
            renderContent();
            // 初始化固定不變的圖標（像是 header 裡的）
            lucide.createIcons();
        });

    </script>
</body>
</html>
